MONGODB_URI=mongodb://localhost:27017/clairco_monitor

# Comma-separated list of origins allowed to call the API / connect over Socket.IO.
# Only enforced when NODE_ENV=production — in development any origin is allowed
# (so the dashboard works from localhost, 127.0.0.1, or a LAN IP without edits here).
FRONTEND_URL=http://localhost:3000

# Shared secret required in the `x-api-key` header for write requests. Leave blank to disable auth (local dev only).
API_KEY=

MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=devices/+/telemetry
MQTT_CLIENT_ID=clairco-monitor
MQTT_AUTO_CREATE_DEVICES=false
MQTT_DEFAULT_EXPECTED_INTERVAL=60
MQTT_RECONNECT_INITIAL_DELAY_MS=1000
MQTT_RECONNECT_MAX_DELAY_MS=30000
MQTT_RECONNECT_FACTOR=2

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=clairco-monitor@clairco.com
ALERT_RECIPIENT=ops-team@clairco.com
SEND_RECOVERY_EMAILS=false

PORT=5000
NODE_ENV=development
LOG_LEVEL=info
ALERT_CHECK_INTERVAL_MS=15000

# Set to true to run the database integration test suite (requires a reachable MONGODB_URI).
RUN_DB_INTEGRATION=false
